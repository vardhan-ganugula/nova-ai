# ==============================================
# Nova AI - Environment Variables Template
# ==============================================

# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000
SESSION_SECRET=your_secret_session_key

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nova_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_ai

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Inngest Configuration
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# AI Provider API Keys
OPEN_ROUTER_API_KEY=
FAL_AI_API_KEY=

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=

# Meta / Instagram OAuth (Instagram Graph API / Professional Accounts)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
SOCIAL_TOKEN_ENCRYPTION_KEY=your_secure_32_character_token_encryption_key_here

