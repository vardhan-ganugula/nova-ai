{
  "name": "nova-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:infra": "docker compose up postgres redis inngest",
    "docker:db:push": "docker compose exec server npm run db:push"
  }
}
